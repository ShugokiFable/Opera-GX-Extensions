{
  "manifest_version": 3,
  "key": "",
  "name": "PopShield GX",
  "short_name": "PopShield",
  "version": "1.0.2",
  "description": "Local-only popup, popunder, click-hijack and interstitial blocker for Opera GX and Chromium. No telemetry, no remote config, no accounts.",
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "PopShield GX",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "ui/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/policy.js",
        "src/hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/guard.js"
      ],
      "css": [
        "src/guard.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "popup_networks",
        "enabled": true,
        "path": "rules/popup_networks.json"
      }
    ]
  },
  "commands": {
    "kill-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Remove blocking overlays on this page"
    }
  }
}
